{
  "info": {
    "name": "Maqas Capstone2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Customer - Add",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/customer/add",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ahmed\",\n  \"email\": \"ahmed@example.com\",\n  \"phoneNumber\": \"0501234567\",\n  \"password\": \"abc123\",\n  \"city\": \"Makkah\"\n}"
        }
      }
    },
    {
      "name": "Customer - Get All",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/customer/get"
      }
    },
    {
      "name": "Tailor Shop - Add",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/tailor-shop/add",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Makkah Tailors\",\n  \"ownerName\": \"Khaled\",\n  \"email\": \"shop@example.com\",\n  \"phoneNumber\": \"0512345678\",\n  \"city\": \"Makkah\",\n  \"specialty\": \"ALL\",\n  \"rating\": 5\n}"
        }
      }
    },
    {
      "name": "Tailor Shop - Get All",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/tailor-shop/get"
      }
    },
    {
      "name": "Measurement - Add",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/measurement/add",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": 1,\n  \"shoulder\": 45.5,\n  \"chest\": 98.0,\n  \"waist\": 82.0,\n  \"sleeveLength\": 60.0,\n  \"height\": 175.0,\n  \"notes\": \"Prefer loose fit\"\n}"
        }
      }
    },
    {
      "name": "Measurement - Get Customer Measurements",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/measurement/customer/1"
      }
    },
    {
      "name": "Order - Create",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/order/create",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": 1,\n  \"tailorShopId\": 1,\n  \"category\": \"THOBE\",\n  \"fabricType\": \"Cotton\",\n  \"color\": \"White\",\n  \"price\": 250.0,\n  \"status\": \"PENDING\",\n  \"orderDate\": \"2026-05-14\",\n  \"deliveryDate\": \"2026-05-20\"\n}"
        }
      }
    },
    {
      "name": "Order - Get All",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/order/get"
      }
    },
    {
      "name": "Order - Change Status",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/v1/order/change-status/1/READY"
      }
    },
    {
      "name": "Order - Customer Orders",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/order/customer/1"
      }
    },
    {
      "name": "Order - AI Trends",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/order/ai/order-trends"
      }
    }
  ]
}
