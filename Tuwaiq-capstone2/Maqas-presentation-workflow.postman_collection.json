                "{{orderId}}",
                "IN_PROGRESS"
              ]
            },
            "description": "This demonstrates the notification integration when order status changes."
          }
        },
        {
          "name": "6. Change Order Status - Ready",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/order/change-status/{{orderId}}/READY",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "order",
                "change-status",
                "{{orderId}}",
                "READY"
              ]
            },
            "description": "This is the second notification moment in the demo."
          }
        },
        {
          "name": "7. ChatGPT Clothing Suggestions - ABAYA",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/order/ai/suggest/ABAYA",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "order",
                "ai",
                "suggest",
                "ABAYA"
              ]
            },
            "description": "Shows customer-facing ChatGPT suggestions for ABAYA colors and fabric types based on recent orders."
          }
        }
      ]
    },
    {
      "name": "03 - Error Handling Demo",
      "description": "Use these requests to show clean validation and business-rule errors without global exception handling.",
      "item": [
        {
          "name": "Duplicate Customer Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sara Saleh\",\n  \"email\": \"noura@example.com\",\n  \"phoneNumber\": \"0500000001\",\n  \"password\": \"sara123\",\n  \"city\": \"Jeddah\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customer/add",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "add"
              ]
            },
            "description": "Expected response: 400 with message: Email already exists."
          }
        },
        {
          "name": "Duplicate Customer Phone Number",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sara Saleh\",\n  \"email\": \"sara@example.com\",\n  \"phoneNumber\": \"0512345678\",\n  \"password\": \"sara123\",\n  \"city\": \"Jeddah\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customer/add",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "add"
              ]
            },
            "description": "Expected response: 400 with message: Phone number already exists."
          }
        },
        {
          "name": "Invalid Order Status",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/order/change-status/{{orderId}}/FINISHED",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "order",
                "change-status",
                "{{orderId}}",
                "FINISHED"
              ]
            },
            "description": "Expected response: 400 with valid status message."
          }
        },
        {
          "name": "Unsupported Tailor Shop Category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"tailorShopId\": {{tailorShopId}},\n  \"category\": \"UNIFORM\",\n  \"fabricType\": \"Polyester\",\n  \"color\": \"Navy\",\n  \"status\": \"PENDING\",\n  \"orderDate\": \"2026-05-14\",\n  \"deliveryDate\": \"2026-06-05\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/order/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "order",
                "create"
              ]
            },
            "description": "This will succeed when the demo shop specialty is ALL. Change the shop specialty to THOBE first if you want to demonstrate the unsupported category error."
          }
        }
      ]
    },
    {
