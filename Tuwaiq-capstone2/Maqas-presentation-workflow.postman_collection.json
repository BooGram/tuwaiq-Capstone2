{
  "info": {
    "name": "Maqas Presentation Workflow",
    "_postman_id": "maqas-presentation-workflow",
    "description": "Clean demo workflow for Maqas Capstone2: customer registration, tailor shop setup, measurements, order creation, notifications, filtering, and ChatGPT clothing suggestions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "customerId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "tailorShopId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "measurementId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Setup Demo Data",
      "description": "Run these requests first after starting the Spring Boot app. They create the main customer, tailor shop, measurements, and order used in the presentation.",
      "item": [
        {
          "name": "1. Register Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Customer created\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.sendRequest(pm.collectionVariables.get(\"baseUrl\") + \"/api/v1/customer/get\", function (err, res) {",
                  "    if (!err) {",
                  "        const customers = res.json();",
                  "        const customer = customers.find(c => c.email === \"noura@example.com\");",
                  "        if (customer) {",
                  "            pm.collectionVariables.set(\"customerId\", customer.id);",
                  "        }",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Noura Saleh\",\n  \"email\": \"noura@example.com\",\n  \"phoneNumber\": \"0512345678\",\n  \"password\": \"noura123\",\n  \"city\": \"Riyadh\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customer/add",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "add"
              ]
            },
            "description": "Creates a customer account. This demonstrates validation, unique email/phone checks, and database insert."
          }
        },
        {
          "name": "2. Add Tailor Shop",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Tailor shop created\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.sendRequest(pm.collectionVariables.get(\"baseUrl\") + \"/api/v1/tailor-shop/get\", function (err, res) {",
                  "    if (!err) {",
                  "        const shops = res.json();",
                  "        const shop = shops.find(s => s.email === \"almashal@example.com\");",
                  "        if (shop) {",
                  "            pm.collectionVariables.set(\"tailorShopId\", shop.id);",
                  "        }",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Al Mashal Tailors\",\n  \"ownerName\": \"Fahad Alotaibi\",\n  \"email\": \"almashal@example.com\",\n  \"phoneNumber\": \"0598765432\",\n  \"city\": \"Riyadh\",\n  \"specialty\": \"ALL\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tailor-shop/add",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tailor-shop",
                "add"
              ]
            },
            "description": "Creates a tailor shop that supports all clothing categories."
          }
        },
        {
          "name": "3. Save Customer Measurements",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Measurement saved\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.sendRequest(pm.collectionVariables.get(\"baseUrl\") + \"/api/v1/measurement/customer/\" + pm.collectionVariables.get(\"customerId\"), function (err, res) {",
                  "    if (!err) {",
                  "        const measurements = res.json();",
                  "        if (measurements.length > 0) {",
                  "            pm.collectionVariables.set(\"measurementId\", measurements[measurements.length - 1].id);",
                  "        }",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"shoulder\": 43.5,\n  \"chest\": 96.0,\n  \"waist\": 82.0,\n  \"sleeveLength\": 59.0,\n  \"height\": 164.0,\n  \"notes\": \"Prefers modest loose fit\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/measurement/add",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "measurement",
                "add"
              ]
            },
            "description": "Stores measurements linked to the customer."
          }
        },
        {
          "name": "4. Create Custom Clothing Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Order created\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.sendRequest(pm.collectionVariables.get(\"baseUrl\") + \"/api/v1/order/customer/\" + pm.collectionVariables.get(\"customerId\"), function (err, res) {",
                  "    if (!err) {",
                  "        const orders = res.json();",
                  "        if (orders.length > 0) {",
                  "            pm.collectionVariables.set(\"orderId\", orders[orders.length - 1].id);",
                  "        }",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"tailorShopId\": {{tailorShopId}},\n  \"category\": \"ABAYA\",\n  \"fabricType\": \"Crepe\",\n  \"color\": \"Black\",\n  \"status\": \"PENDING\",\n  \"orderDate\": \"2026-05-14\",\n  \"deliveryDate\": \"2026-06-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/order/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "order",
                "create"
              ]
            },
            "description": "Creates an order. This triggers email and WhatsApp notification logic."
          }
        }
      ]
    },
    {
      "name": "02 - Main Presentation Flow",
      "description": "Use this folder to show the main user journey and integrations.",
      "item": [
        {
