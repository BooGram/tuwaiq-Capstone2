        },
        {
          "name": "5. Change Order Status - In Progress",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/order/change-status/{{orderId}}/IN_PROGRESS",
