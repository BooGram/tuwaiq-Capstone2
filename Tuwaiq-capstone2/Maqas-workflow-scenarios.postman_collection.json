              ],
              "path": [
                "api",
                "v1",
                "tailor-shop",
                "city",
                "Riyadh"
              ]
            }
          }
        },
        {
          "name": "2. View Customer Measurements",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/measurement/customer/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "measurement",
                "customer",
                "{{customerId}}"
              ]
            }
          }
        },
        {
          "name": "3. View Customer Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/order/customer/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "order",
                "customer",
                "{{customerId}}"
              ]
            }
          }
        },
        {
          "name": "4. Tailor Sends Price Quote",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/order/quote/{{abayaOrderId}}/420",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "order",
                "quote",
                "{{abayaOrderId}}",
                "420"
              ]
            },
            "description": "Tailor shop reviews the order and sends a price quote to the customer. This triggers email and WhatsApp."
          }
        },
        {
          "name": "5. Customer Accepts Price Quote",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/order/accept-quote/{{abayaOrderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "order",
                "accept-quote",
                "{{abayaOrderId}}"
              ]
            },
            "description": "Customer accepts the quoted price, so the order moves from QUOTED to ACCEPTED."
          }
        },
        {
          "name": "6. Update Order Status - READY",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/order/change-status/{{abayaOrderId}}/READY",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "order",
                "change-status",
                "{{abayaOrderId}}",
                "READY"
              ]
            },
            "description": "Tailor updates the accepted order. This triggers email and WhatsApp notification for the customer."
          }
        },
        {
          "name": "7. ChatGPT Suggestions for ABAYA",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/order/ai/suggest/ABAYA",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
