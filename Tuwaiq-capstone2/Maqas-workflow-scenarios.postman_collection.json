{
  "info": {
    "name": "Maqas Workflow Scenarios",
    "_postman_id": "maqas-workflow-scenarios",
    "description": "Workflow-focused Postman collection for Maqas Capstone2. Covers customer setup, tailor shop setup, measurements, order creation, notifications, ChatGPT clothing suggestions, filtering, and error handling.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "customerId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "tailorShopId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "thobeOnlyShopId",
      "value": "2",
      "type": "string"
    },
    {
      "key": "measurementId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "abayaOrderId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "thobeOrderId",
      "value": "4",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Start Here: Create Main Demo Data",
      "description": "Run this folder first after starting Spring Boot. It creates the main customer, tailor shops, and measurements.",
      "item": [
        {
          "name": "1. Register Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Customer request succeeded\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "});",
                  "",
                  "pm.sendRequest(pm.collectionVariables.get(\"baseUrl\") + \"/api/v1/customer/get\", function (err, res) {",
                  "    if (!err) {",
                  "        const customers = res.json();",
                  "        const customer = customers.find(c => c.email === \"noura@example.com\");",
                  "        if (customer) pm.collectionVariables.set(\"customerId\", customer.id);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Noura Saleh\",\n  \"email\": \"noura@example.com\",\n  \"phoneNumber\": \"0512345678\",\n  \"password\": \"noura123\",\n  \"city\": \"Riyadh\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customer/add",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "add"
              ]
            },
            "description": "Creates the customer used through the demo."
          }
        },
        {
          "name": "2. Add Main Tailor Shop - Supports All Categories",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Tailor shop request succeeded\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "});",
                  "",
                  "pm.sendRequest(pm.collectionVariables.get(\"baseUrl\") + \"/api/v1/tailor-shop/get\", function (err, res) {",
                  "    if (!err) {",
                  "        const shops = res.json();",
                  "        const shop = shops.find(s => s.email === \"almashal@example.com\");",
                  "        if (shop) pm.collectionVariables.set(\"tailorShopId\", shop.id);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Al Mashal Tailors\",\n  \"ownerName\": \"Fahad Alotaibi\",\n  \"email\": \"almashal@example.com\",\n  \"phoneNumber\": \"0598765432\",\n  \"city\": \"Riyadh\",\n  \"specialty\": \"ALL\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tailor-shop/add",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tailor-shop",
                "add"
              ]
            },
            "description": "Creates a shop that accepts all order categories."
          }
        },
        {
          "name": "3. Add THOBE Only Tailor Shop",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"THOBE shop request succeeded\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "});",
                  "",
                  "pm.sendRequest(pm.collectionVariables.get(\"baseUrl\") + \"/api/v1/tailor-shop/get\", function (err, res) {",
                  "    if (!err) {",
                  "        const shops = res.json();",
                  "        const shop = shops.find(s => s.email === \"althobe@example.com\");",
                  "        if (shop) pm.collectionVariables.set(\"thobeOnlyShopId\", shop.id);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Al Thobe House\",\n  \"ownerName\": \"Saad Alqahtani\",\n  \"email\": \"althobe@example.com\",\n  \"phoneNumber\": \"0500000002\",\n  \"city\": \"Riyadh\",\n  \"specialty\": \"THOBE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tailor-shop/add",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tailor-shop",
                "add"
              ]
            },
            "description": "Creates a THOBE-only shop for the unsupported category error scenario."
          }
        },
        {
          "name": "4. Save Customer Measurements",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Measurement request succeeded\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "});",
                  "",
                  "pm.sendRequest(pm.collectionVariables.get(\"baseUrl\") + \"/api/v1/measurement/customer/\" + pm.collectionVariables.get(\"customerId\"), function (err, res) {",
                  "    if (!err && res.code === 200) {",
                  "        const measurements = res.json();",
                  "        if (measurements.length > 0) pm.collectionVariables.set(\"measurementId\", measurements[measurements.length - 1].id);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"shoulder\": 43.5,\n  \"chest\": 96.0,\n  \"waist\": 82.0,\n  \"sleeveLength\": 59.0,\n  \"height\": 164.0,\n  \"notes\": \"Prefers modest loose fit\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/measurement/add",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "measurement",
                "add"
              ]
            },
            "description": "Stores measurements linked to the customer."
          }
        }
      ]
    },
    {
      "name": "02 - Seed Recent Orders for ChatGPT Trends",
      "description": "Run this folder to create current-month orders. These orders give ChatGPT data to suggest trending colors and fabrics.",
      "item": [
        {
          "name": "1. ABAYA Order - Black Crepe",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"ABAYA order created\", function () { pm.response.to.have.status(200); });",
                  "pm.sendRequest(pm.collectionVariables.get(\"baseUrl\") + \"/api/v1/order/customer/\" + pm.collectionVariables.get(\"customerId\"), function (err, res) {",
                  "    if (!err && res.code === 200) {",
                  "        const orders = res.json().filter(o => o.category === \"ABAYA\");",
                  "        if (orders.length > 0) pm.collectionVariables.set(\"abayaOrderId\", orders[orders.length - 1].id);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": {{customerId}},\n  \"tailorShopId\": {{tailorShopId}},\n  \"category\": \"ABAYA\",\n  \"fabricType\": \"Crepe\",\n  \"color\": \"Black\",\n  \"status\": \"PENDING\",\n  \"orderDate\": \"2026-05-16\",\n  \"deliveryDate\": \"2026-06-01\"\n}"
