    {
      "name": "03 - Main Customer Workflow Demo",
      "description": "Use this folder during the presentation to show the customer journey and integrations.",
      "item": [
        {
          "name": "1. Browse Tailor Shops in Riyadh",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tailor-shop/city/Riyadh",
              "host": [
